# Konfigurasi Koneksi Database
# Default: SQLite (praktis untuk local development tanpa perlu install server database)
DATABASE_URL=sqlite:///./etacafe.db

# Alternatif: PostgreSQL (untuk deployment / production)
# DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@localhost:5432/EtaCafe_db

# Keamanan JWT Token
SECRET_KEY=supersecretjwtkey_restoflow_unhas_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server & CORS
APP_PORT=8000
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5500","http://127.0.0.1:3000","http://127.0.0.1:5173","http://127.0.0.1:5500"]
